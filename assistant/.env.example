# Copy to .env and fill in. Only GEMINI_API_KEY is needed to go live.

# --- LLM providers (at least one recommended; falls back to offline if none) ---
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (free tier)
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=              # optional fallback — https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER_ORDER=gemini,groq,offline
LLM_TIMEOUT=20

# --- voice-out / TTS (optional; frontend falls back to browser TTS if unset) ---
ELEVENLABS_API_KEY=        # https://elevenlabs.io  (only this is required to enable TTS)
ELEVENLABS_VOICE_ID=       # optional — defaults to a public voice (Rachel) if blank
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_MAX_CHARS=400          # per-request cap (TTS is the main paid component)

# --- retrieval / grounding ---
EMBED_BACKEND=bge          # bge (semantic, default) | hashing (offline smoke)
TOP_K=4
MIN_RELEVANCE=0.30         # below this top similarity -> refuse (no LLM call)
# ASSISTANT_DATA_DIR=/tmp/assistant_data   # if repo is on a mounted FS

# --- caching / observability ---
CACHE_TTL=3600            # response-cache freshness (seconds); 0-ish to effectively disable
CACHE_MAX=200             # max cached answers
TTS_CACHE_MAX=128         # max cached TTS clips
STATS_TOKEN=              # if set, /stats requires ?token=<this>

# --- server hardening ---
ALLOWED_ORIGINS=https://ksubodh9.github.io,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MIN=15
DAILY_CAP=500              # crude spend cap / kill switch
MAX_MESSAGE_CHARS=500
